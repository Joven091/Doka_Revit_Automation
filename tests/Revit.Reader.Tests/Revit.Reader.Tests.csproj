<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <AssemblyName>Revit.Reader.Tests</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <RevitReaderSource Condition="'$(RevitReaderSource)' == ''">../../src/Revit/RevitStructureSelection.cs</RevitReaderSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RevitReaderSource)" Link="RevitStructureSelection.cs" />
    <ProjectReference Include="../Beam.Tests/Beam.Tests.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="../Beam.Net48/Beam.Net48.csproj" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
