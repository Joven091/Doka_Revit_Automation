<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Doka.EngineeringDashboard</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <Version>1.2.0</Version>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../../src/MyRevitAddin.csproj" AdditionalProperties="DashboardDesktopBuild=true;Version=$(Version)" />
  </ItemGroup>
  <Target Name="CopyDashboardNativePayload" AfterTargets="Build">
    <ItemGroup><DashboardNativePayload Include="../../src/bin/$(Configuration)/dashboard/net48/*.dll" /></ItemGroup>
    <Copy SourceFiles="@(DashboardNativePayload)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Error Condition="Exists('$(TargetDir)RevitAPI.dll') Or Exists('$(TargetDir)RevitAPIUI.dll')" Text="The external Dashboard must not distribute Revit host assemblies." />
    <Error Condition="!Exists('$(TargetDir)google-ortools-native.dll') Or !Exists('$(TargetDir)WebView2Loader.dll')" Text="The external Dashboard requires its native solver and browser payload." />
  </Target>
</Project>
