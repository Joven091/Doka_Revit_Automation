<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Top50Planner</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Google.OrTools" Version="9.12.4544" />
    <PackageReference Include="IxMilia.Dxf" Version="0.8.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="../../src/Top50/*.cs" Link="Planner/%(Filename)%(Extension)" />
    <Compile Include="../../src/ViewModels/Top50ViewModel*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/Views/Top50Window.cs" Link="Views/Top50Window.cs" />
    <Compile Include="../../src/Views/Top50DiagnosticWindow.cs" Link="Views/Top50DiagnosticWindow.cs" />
    <Page Include="../../src/Views/CalculatorStyles.xaml" Link="Views/CalculatorStyles.xaml" />
  </ItemGroup>
  <Target Name="ValidatePortableNativePayload" AfterTargets="Build">
    <Error Condition="!Exists('$(TargetDir)google-ortools-native.dll') Or !Exists('$(TargetDir)ortools.dll')" Text="The standalone Top50 tester requires the win-x64 native OR-Tools payload beside Top50Planner.exe." />
  </Target>
<ItemGroup><Compile Include="../../src/Views/Top50Window.Revit.cs" Link="Views/Top50Window.Revit.cs"/><Compile Include="../../src/Views/DashboardToolbar.cs" Link="Views/DashboardToolbar.cs"/></ItemGroup></Project>
