<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MyRevitAddin</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Shared plywood helper also defines beam-only receiving-row fields, unused in this Slab host. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="OxyPlot.Core" Version="2.1.2" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.1.2" />
    <Compile Include="../../src/ViewModels/FlexCalculatorViewModel.cs" Link="ViewModels/FlexCalculatorViewModel.cs" />
    <Compile Include="../../src/Models/PropDataHelper.cs" Link="Models/PropDataHelper.cs" />
    <Compile Include="../../src/Models/SlabLoadHelper.cs" Link="Models/SlabLoadHelper.cs" />
    <Compile Include="../../src/Models/FloorPropData.cs" Link="Models/FloorPropData.cs" />
    <Compile Include="../../src/Models/ContinuousBeamResponse.cs" Link="ContinuousBeamResponse.cs" />
    <Compile Include="../../src/Models/ContinuousSpanDeflection.cs" Link="Models/ContinuousSpanDeflection.cs" />
    <Compile Include="../../src/Models/DiagramDataGenerator.cs" Link="Models/DiagramDataGenerator.cs" />
    <Compile Include="../../src/ViewModels/DiagramWindowViewModel.cs" Link="ViewModels/DiagramWindowViewModel.cs" />
    <Compile Include="../../src/ViewModels/DiagramRowItem.cs" Link="ViewModels/DiagramRowItem.cs" />
    <Compile Include="../../src/ViewModels/RelayCommand.cs" Link="ViewModels/RelayCommand.cs" />
    <Compile Include="../../src/Views/FlexCalculatorWindow.ui.cs" Link="Views/FlexCalculatorWindow.ui.cs" />
    <Page Include="../../src/Views/FlexCalculatorWindow.xaml" Link="FlexCalculatorWindow.xaml" />
    <Page Include="../../src/Views/CalculatorStyles.xaml" Link="Views/CalculatorStyles.xaml" />
    <Compile Include="../../src/Views/SlabSupportDiagram.cs" Link="SlabSupportDiagram.cs" />
    <Compile Include="../../src/Models/CalculationFiles.cs" Link="CalculationFiles.cs" />
    <Compile Include="../../src/Models/PlywoodSpacing.cs" Link="Models/PlywoodSpacing.cs" />
    <Page Include="../../src/Views/DiagramWindow.xaml" Link="Views/DiagramWindow.xaml" />
    <Compile Include="../../src/Views/DiagramWindow.xaml.cs" Link="Views/DiagramWindow.xaml.cs" />
  </ItemGroup>
</Project>