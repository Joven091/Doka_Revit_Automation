<Window x:Class="EngineeringDashboard.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Engineering Calculators" Height="330" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select a Calculator:" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Grid.Row="0"/>

        <Button x:Name="BtnFlexCalculator" Content="Slab Calculator"
                Grid.Row="1" Margin="10" FontSize="14" FontWeight="SemiBold"
                Background="#007ACC" Foreground="White" BorderThickness="0"
                Click="BtnFlexCalculator_Click"/>

        <Button x:Name="BtnBeamCalculator" Content="Beam Calculator"
                Grid.Row="2" Margin="10" FontSize="14" FontWeight="SemiBold"
                Background="#28A745" Foreground="White" BorderThickness="0"
                Click="BtnBeamCalculator_Click"/>
        <Button Content="Backpropping Calculator" Grid.Row="3" Margin="10"
                FontSize="14" FontWeight="SemiBold" Background="#F2CD24"
                BorderThickness="0" Click="BtnBackpropping_Click"/>
    </Grid>
</Window>
