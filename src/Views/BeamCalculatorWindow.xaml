<Window x:Class="EngineeringDashboard.BeamCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EngineeringDashboard"
        Title="Beam Calculator" Height="780" Width="1100" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Inputs and Results -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Beam &amp; Slab Geometry" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Beam Depth (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Beam Width (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                    <CheckBox Content="Left Slab" IsChecked="{Binding HasLeftSlab}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Text="{Binding LeftSlabThickness, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="2" Grid.Column="1" Margin="0,5" IsEnabled="{Binding HasLeftSlab}" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <CheckBox Content="Right Slab" IsChecked="{Binding HasRightSlab}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Text="{Binding RightSlabThickness, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="3" Grid.Column="1" Margin="0,5" IsEnabled="{Binding HasRightSlab}" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Support &amp; Deflection" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
<RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Props per primary line:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox SelectedValue="{Binding NumberOfProps}" SelectedValuePath="Content" Grid.Row="0" Grid.Column="1" Margin="0,5">
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4+"/>
                    </ComboBox>

                    <Label Content="Deflection Limit:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding DeflectionOptions}" SelectedItem="{Binding DeflectionLimit}" DisplayMemberPath="Label" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                <Label Content="Floor height (mm):" Grid.Row="2"/><TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Text="{Binding FloorHeight, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
<Label Content="Prop type / orientation:" Grid.Row="3"/><ComboBox Grid.Row="3" Grid.Column="1" Margin="0,5" ItemsSource="{Binding PropOptions}" SelectedItem="{Binding SelectedProp}" DisplayMemberPath="Label"/>
<StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="5,4"><TextBlock Text="{Binding PropExtensionMm, StringFormat='Automatic extension: {0:F0} mm'}"/><TextBlock Text="{Binding PropCapacityKn, StringFormat='Permitted prop load: {0:F2} kN'}"/></StackPanel>
</Grid>
            </GroupBox>

            <TextBlock Text="{Binding WarningMessage}" Grid.Row="2" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap" Margin="0,2" MinHeight="30"/>

            <CheckBox Content="Use Custom Load Inputs" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10" IsChecked="{Binding UseCustomLoads, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" FontWeight="SemiBold"/>

            <GroupBox Header="Custom Loads" IsEnabled="{Binding UseCustomLoads}" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10" Padding="10" Visibility="{Binding UseCustomLoads, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Placing + Working Live Load (kN/m²):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CustomLiveLoad, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Formwork Load (kN/m²):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CustomFormworkLoad, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </GroupBox>

            <Border x:Name="ResultsBorder" Visibility="{Binding IsCalculationValid, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Row="7" Grid.ColumnSpan="2" Background="#E8F5E9" Padding="10" Margin="0,5,0,0" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <Label Content="Maximum Prop Spacing (mm):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaximumPropSpacing, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="16" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="0" Grid.Column="1"/>

                    <Label Content="Primary Beam Cantilever (mm):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryBeamCantilever, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="1" Grid.Column="1"/>

                    <Label Content="Maximum Prop Load (kN):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaximumPropLoad, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="2" Grid.Column="1"/>

                    <Label Content="Prop utilization:" Grid.Row="4" FontWeight="Bold" Foreground="#1B5E20"/><TextBlock Grid.Row="4" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding PropUtilizationPercent, StringFormat='{}{0:F1}%'}"/>
<Label Content="Limiting Factor:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LimitingFactor}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ImportButton" IsEnabled="{Binding IsCalculationValid}" Content="Import Values" Width="100" Padding="5" Margin="0,0,10,0" Click="BtnApplyToBeams_Click"/>
                <Button Content="Close" Width="80" Padding="5" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Primary beams run along the concrete beam; secondary beams cross them. -->
        <Border Grid.Column="1" Background="#F0F2F3" CornerRadius="5" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Beam and support arrangement" FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Schematic · secondary H20 perpendicular to primary H20" TextWrapping="Wrap" Foreground="#52616B"/>
                <local:BeamSupportDiagram x:Name="SupportDiagram" Height="460" Margin="0,10"/>
                <TextBlock x:Name="DiagramCaption" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Expander Header="Layout and calculation basis">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="Two primary lines support transverse secondary beams. Each checked slab contributes a 300 mm strip. Primary-line spacing = (beam width + 1400) ÷ 2. Eccentric loads are distributed by equilibrium; the heavier line governs." TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0" Text="Uniform loading and equal longitudinal spans are assumed. Selected prop capacity uses the slab calculator table, rounded up to the next 100 mm extension. Extension = floor height − beam depth − 418 mm. Sheeting, secondary beams, joints and restraint require separate checks. The drawn secondary-beam quantity is illustrative." TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LeftLineLoad, StringFormat='Left primary line: {0:F2} kN/m'}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding RightLineLoad, StringFormat='Right primary line: {0:F2} kN/m'}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Window>

