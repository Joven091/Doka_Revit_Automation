<Window x:Class="EngineeringDashboard.BeamCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam Calculator" Height="460" Width="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Inputs and Results -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Beam Depth (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

            <Label Content="Beam Width (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

            <CheckBox Content="Left Slab" IsChecked="{Binding HasLeftSlab}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Text="{Binding LeftSlabThickness, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <CheckBox Content="Right Slab" IsChecked="{Binding HasRightSlab}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Text="{Binding RightSlabThickness, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,5" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Text="{Binding WarningMessage}" Grid.Row="4" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap" Margin="0,2" Height="30"/>

            <Border Grid.Row="5" Grid.ColumnSpan="2" Background="#E8F5E9" Padding="10" Margin="0,5,0,0" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <Label Content="Maximum Prop Spacing (mm):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaximumPropSpacing, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="16" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="0" Grid.Column="1"/>

                    <Label Content="Primary Beam Cantilever (mm):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryBeamCantilever, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="1" Grid.Column="1"/>

                    <Label Content="Secondary Spacing (mm):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SecondarySpacing, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="2" Grid.Column="1"/>

                    <Label Content="Maximum Prop Load (kN):" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MaximumPropLoad, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="3" Grid.Column="1"/>

                    <Label Content="Limiting Factor:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LimitingFactor}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="4" Grid.Column="1"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,15,0,5">
                <TextBlock Text="Notes:" FontWeight="Bold" Margin="0,0,0,5" />
                <TextBlock Text="- for simple beam (2 supports only) max span is 2000" TextWrapping="Wrap" Margin="10,0,0,2"/>
                <TextBlock Text="- concrete beam at the center of secondary beam" TextWrapping="Wrap" Margin="10,0,0,2"/>
                <TextBlock Text="- limiting deflection to 2mm" TextWrapping="Wrap" Margin="10,0,0,2"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Close" Width="80" Padding="5" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Right Panel: Visualization -->
        <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" Padding="10">
            <Canvas Width="250" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polygon Points="{Binding BeamPolygonPoints}" Fill="LightGray" Stroke="Black" StrokeThickness="2"/>

                <!-- Dimension Lines -->
                <Polyline Points="{Binding WidthDimPoints}" Stroke="#555555" StrokeThickness="1"/>
                <Polyline Points="{Binding DepthDimPoints}" Stroke="#555555" StrokeThickness="1"/>
                <Polyline Points="{Binding LeftSlabDimPoints}" Stroke="#555555" StrokeThickness="1" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Polyline Points="{Binding RightSlabDimPoints}" Stroke="#555555" StrokeThickness="1" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Polyline Points="{Binding LeftSlabWidthDimPoints}" Stroke="#555555" StrokeThickness="1" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Polyline Points="{Binding RightSlabWidthDimPoints}" Stroke="#555555" StrokeThickness="1" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Width Label -->
                <TextBlock Text="{Binding Width}" Canvas.Left="{Binding WidthLabelLeft}" Canvas.Top="{Binding WidthLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12"/>

                <!-- Left Slab Width Label -->
                <TextBlock Text="300" Canvas.Left="{Binding LeftSlabWidthLabelLeft}" Canvas.Top="{Binding LeftSlabWidthLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Right Slab Width Label -->
                <TextBlock Text="300" Canvas.Left="{Binding RightSlabWidthLabelLeft}" Canvas.Top="{Binding RightSlabWidthLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Depth Label -->
                <TextBlock Text="{Binding Depth}" Canvas.Left="{Binding DepthLabelLeft}" Canvas.Top="{Binding DepthLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12"/>

                <!-- Left Slab Thickness Label -->
                <TextBlock Text="{Binding LeftSlabThickness}" Canvas.Left="{Binding LeftSlabLabelLeft}" Canvas.Top="{Binding LeftSlabLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12" Visibility="{Binding HasLeftSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Right Slab Thickness Label -->
                <TextBlock Text="{Binding RightSlabThickness}" Canvas.Left="{Binding RightSlabLabelLeft}" Canvas.Top="{Binding RightSlabLabelTop}" Foreground="DarkBlue" FontWeight="Bold" FontSize="12" Visibility="{Binding HasRightSlab, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Canvas>
        </Border>
    </Grid>
</Window>
