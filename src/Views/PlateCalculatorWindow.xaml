<Window x:Class="EngineeringDashboard.PlateCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Steel Plate Calculator" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Tie Load (kN):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding LoadKN, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

        <Label Content="Span (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Span, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

        <Label Content="Total Plate Width (mm):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PlateWidth, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

        <Label Content="Tie Hole Diameter (mm):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding HoleDia, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

        <Label Content="Nut Bearing Diameter (mm):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding NutDia, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

        <Label Content="Steel Yield Strength (py):" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding YieldOptions}" SelectedItem="{Binding SelectedYield}" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="{Binding WarningMessage}" Grid.Row="6" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap" Margin="0,5" Height="20" FontWeight="Bold"/>

        <Label Content="Req. Bending Thickness:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ReqBendingThickness, StringFormat={}{0:F2} mm}" Grid.Row="7" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" Foreground="Gray"/>

        <Label Content="Req. Punching Thickness:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ReqPunchingThickness, StringFormat={}{0:F2} mm}" Grid.Row="8" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" Foreground="Gray"/>

        <Border Grid.Row="9" Grid.ColumnSpan="2" Background="#E8F5E9" Padding="10" Margin="0,10,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Recommended Thickness:" FontWeight="Bold" Foreground="#2E7D32"/>
                <TextBlock Text="{Binding RecommendedThickness}" FontWeight="Bold" FontSize="16" Foreground="#1B5E20" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Formulas Info" Width="100" Margin="0,0,10,0" Padding="5" Click="BtnInfo_Click" Background="#E0E0E0"/>
            <Button Content="Close" Width="80" Padding="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>