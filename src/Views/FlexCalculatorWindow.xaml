<Window x:Class="EngineeringDashboard.FlexCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flex Calculator Dashboard" Height="780" Width="500"
        WindowStartupLocation="CenterScreen">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

            <GroupBox Header="Slab" Grid.Row="0" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Slab Thickness (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SlabThickness, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Floor Height (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding FloorHeight, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Secondary Beam Layout" Grid.Row="1" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Primary Beam Count:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PrimaryBeamCount, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Secondary Beam Spacing (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SecondaryBeamSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Secondary Beam Cantilever (mm):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SecondaryBeamCantilever, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Primary Beam &amp; Prop Layout" Grid.Row="2" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Content="Selected H20 Timber:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding H20Options}" SelectedItem="{Binding SelectedH20, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Recommended Prop Spacing (m):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock Text="{Binding RecommendedPropSpacing, StringFormat={}{0:F2}}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="5,5,0,5" Foreground="Gray" FontWeight="SemiBold"/>

                    <Label Content="Actual Prop Spacing (mm):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PropSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Prop Count:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PropCount, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Primary Beam Cantilever (mm):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PrimaryBeamCantilever, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Prop Type Eurex eco 20:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PropTypeOptions}" SelectedItem="{Binding PropType, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="0,5"/>

                    <Label Content="Prop Orientation:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PropOrientationOptions}" SelectedItem="{Binding PropOrientation, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="0,5"/>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding WarningMessage}" Grid.Row="3" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" MinHeight="20"/>

            <Border Grid.Row="4" Background="#E8F5E9" Padding="15" Margin="0,5,0,10" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Primary Beam Spacing:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SuggestedPrimaryBeamSpacing, StringFormat={}{0:F0}}" FontWeight="Bold" FontSize="18" Foreground="#2E7D32"/>
                        <TextBlock Text=" mm" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                    </StackPanel>

                    <Label Content="Actual Prop Load / Limit:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="{Binding ActualPropLoad, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32"/>
                        <TextBlock Text=" / " FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                        <TextBlock Text="{Binding PropCapacityLimit, StringFormat={}{0:F2} kN}" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                    </StackPanel>

                    <Label Content="Prop Utilization:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UtilizationRate, StringFormat={}{0:F1} %}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Row="2" Grid.Column="1"/>

                    <Label Content="H20 Shear Utilization:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding H20Utilization, StringFormat={}{0:F1} %}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" Grid.Column="1"/>
                </Grid>
            </Border>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="Close" Width="100" Padding="8" Click="BtnClose_Click" Background="#f0f0f0" BorderBrush="#ccc"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>