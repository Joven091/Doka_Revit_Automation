<Window x:Class="EngineeringDashboard.FlexCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floor Prop Optimization" Height="650" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Slab Thickness (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding SlabThickness, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

        <Label Content="Floor Height (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FloorHeight, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

        <Label Content="Prop Type Eurex 20 eco:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding PropTypeOptions}" SelectedItem="{Binding PropType}" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

        <Label Content="Prop Orientation:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding PropOrientationOptions}" SelectedItem="{Binding PropOrientation}" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

        <Label Content="H20 Component:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding H20Options}" SelectedItem="{Binding SelectedH20}" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

        <Label Content="Recommended Prop Spacing:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding RecommendedPropSpacing, StringFormat={}{0} mm}" Grid.Row="5" Grid.Column="1" Margin="0,5" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>

        <Label Content="Primary Beam Count (Supports):" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PrimaryBeamCount, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="0,5"/>

        <Label Content="Secondary Beam Cantilever (mm):" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding SecondaryBeamCantilever, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" Margin="0,5"/>

        <Label Content="Prop Count (Supports):" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PropCount, UpdateSourceTrigger=PropertyChanged}" Grid.Row="8" Grid.Column="1" Margin="0,5"/>

        <Label Content="Prop Spacing (mm):" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PropSpacing, UpdateSourceTrigger=PropertyChanged}" Grid.Row="9" Grid.Column="1" Margin="0,5"/>

        <Label Content="Primary Beam Cantilever (mm):" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PrimaryBeamCantilever, UpdateSourceTrigger=PropertyChanged}" Grid.Row="10" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="{Binding WarningMessage}" Grid.Row="11" Grid.ColumnSpan="2" Foreground="Red" TextWrapping="Wrap" Margin="0,5" Height="40"/>

        <Border Grid.Row="12" Grid.ColumnSpan="2" Background="#E8F5E9" Padding="10" Margin="0,10,0,0" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Suggested Primary Beam Spacing:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SuggestedPrimaryBeamSpacing, StringFormat={}{0} mm}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="0" Grid.Column="1"/>

                <Label Content="Actual Prop Load:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ActualPropLoad, StringFormat={}{0:F2} kN}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="1" Grid.Column="1"/>

                <Label Content="Prop Capacity limit used:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PropCapacityLimit, StringFormat={}{0:F2} kN}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="2" Grid.Column="1"/>

                <Label Content="Prop Utilization Rate:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UtilizationRate, StringFormat={}{0:F1} %}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="3" Grid.Column="1"/>

                <Label Content="H20 Shear:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding H20Shear, StringFormat={}{0:F2} kN}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="4" Grid.Column="1"/>

                <Label Content="H20 Utilization:" FontWeight="Bold" Foreground="#1B5E20" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding H20Utilization, StringFormat={}{0:F1} %}" FontWeight="Bold" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="5" Grid.Column="1"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Formulas Info" Width="100" Margin="0,0,10,0" Padding="5" Click="BtnInfo_Click" Background="#E0E0E0"/>
            <Button Content="Close" Width="80" Padding="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>