<Window x:Class="MyRevitAddin.Views.DiagramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="800" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <oxy:PlotView Model="{Binding ShearPlot}" Grid.Row="0" Margin="10" />
        <oxy:PlotView Model="{Binding MomentPlot}" Grid.Row="1" Margin="10" />
        <oxy:PlotView Model="{Binding DeflectionPlot}" Grid.Row="2" Margin="10" />
    </Grid>
</Window>
