(defun c:EngDashboard ( / dclFile dclID ret mainLoop )
  (vl-load-com)
  (setq dclFile (WriteDCL))
  (setq dclID (load_dialog dclFile))

  (if (< dclID 0)
      (progn (princ "\nError loading DCL file.") (exit))
  )

  (setq mainLoop T)
  (while mainLoop
    (if (not (new_dialog "EngDashMain" dclID))
        (progn (princ "\nError displaying Main Dialog.") (setq mainLoop nil))
    )

    (if (= *glb_opt* "Flex")
        (set_tile "rb_flex" "1")
        (set_tile "rb_plate" "1")
    )

    (action_tile "rb_flex" "(setq *glb_opt* \"Flex\")")
    (action_tile "rb_plate" "(setq *glb_opt* \"Plate\")")
    (action_tile "accept" "(done_dialog 1)")
    (action_tile "cancel" "(done_dialog 0)")

    (setq ret (start_dialog))

    (if (= ret 1)
        (if (= *glb_opt* "Flex")
            (RunFlexDialog dclID)
            (RunPlateDialog dclID)
        )
        (setq mainLoop nil) ;; Cancel clicked
    )
  )

  (unload_dialog dclID)
  (vl-file-delete dclFile)
  (princ)
)

(defun RunFlexDialog ( dclID / flexLoop ret sT slabLoad x_vals x1 x2 maxP1 maxP2 interpolatedMaxProp z1 z2 finalZ currentBeamSpacing extensionMeters roundedExtension key vCap L P_m a a_over_L R_max propLoad vMax capacity actualPropLoad propCapLimit utilRate h20Shear h20Util val_thk val_fht val_spc val_can calc_success warningMsg pt_idx po_idx)
  (setq flexLoop T)
  (while flexLoop
    (if (not (new_dialog "EngDashFlexIn" dclID))
        (progn (princ "\nError displaying Flex Input Dialog.") (setq flexLoop nil) (exit))
    )

    (start_list "pl_prop_typ") (mapcar 'add_list '("250" "300" "350" "400" "550")) (end_list)
    (start_list "pl_prop_ori") (mapcar 'add_list '("bottom" "top")) (end_list)

    (setq pt_idx "1")
    (cond ((= *glb_prop_type* "250") (setq pt_idx "0"))
          ((= *glb_prop_type* "300") (setq pt_idx "1"))
          ((= *glb_prop_type* "350") (setq pt_idx "2"))
          ((= *glb_prop_type* "400") (setq pt_idx "3"))
          ((= *glb_prop_type* "550") (setq pt_idx "4")))

    (setq po_idx "0")
    (if (= *glb_prop_ori* "top") (setq po_idx "1"))

    (set_tile "eb_slab_thk" *glb_slab_thk*)
    (set_tile "eb_floor_ht" *glb_floor_ht*)
    (set_tile "pl_prop_typ" pt_idx)
    (set_tile "pl_prop_ori" po_idx)
    (set_tile "eb_prop_spc" *glb_prop_spc*)
    (set_tile "eb_sec_cant" *glb_sec_cant*)

    (action_tile "eb_slab_thk" "(setq *glb_slab_thk* $value)")
    (action_tile "eb_floor_ht" "(setq *glb_floor_ht* $value)")
    (action_tile "pl_prop_typ" "(setq idx (atoi $value)) (cond ((= idx 0) (setq *glb_prop_type* \"250\")) ((= idx 1) (setq *glb_prop_type* \"300\")) ((= idx 2) (setq *glb_prop_type* \"350\")) ((= idx 3) (setq *glb_prop_type* \"400\")) ((= idx 4) (setq *glb_prop_type* \"550\")) )")
    (action_tile "pl_prop_ori" "(setq idx (atoi $value)) (if (= idx 0) (setq *glb_prop_ori* \"bottom\") (setq *glb_prop_ori* \"top\"))")
    (action_tile "eb_prop_spc" "(setq *glb_prop_spc* $value)")
    (action_tile "eb_sec_cant" "(setq *glb_sec_cant* $value)")

    (action_tile "btn_calc" "(done_dialog 2)")
    (action_tile "cancel" "(done_dialog 0)")

    (setq ret (start_dialog))

    (if (= ret 2)
        (progn
          ;; PERFORM CALCULATION
          (setq val_thk (atof *glb_slab_thk*))
          (setq val_fht (atof *glb_floor_ht*))
          (setq val_spc (atof *glb_prop_spc*))
          (setq val_can (atof *glb_sec_cant*))
          (setq warningMsg "")

          (setq sT val_thk)
          (if (< sT 200.0) (setq sT 200.0))
          (if (> sT 500.0) (setq sT 500.0))
          (if (/= sT val_thk)
              (setq warningMsg (strcat "Warning: Slab Thickness adjusted to " (rtos sT 2 1) "mm. "))
          )

          (setq slabLoad (CalculateTotalLoad sT))

          (setq x_vals '(200.0 220.0 240.0 260.0 280.0 300.0 350.0 400.0 450.0 500.0))
          (setq x1 (car x_vals))
          (foreach x x_vals (if (<= x sT) (setq x1 x)))
          (setq x2 (last x_vals))
          (foreach x (reverse x_vals) (if (>= x sT) (setq x2 x)))
          (if (= x1 0) (setq x1 x2))
          (if (= x2 0) (setq x2 x1))

          (setq maxP1 (GetMaxPropForThickness x1))
          (setq maxP2 (GetMaxPropForThickness x2))

          (if (= x1 x2)
              (setq interpolatedMaxProp maxP1)
              (setq interpolatedMaxProp (+ maxP1 (* (- sT x1) (/ (- maxP2 maxP1) (- x2 x1)))))
          )

          (if (> val_spc interpolatedMaxProp)
              (progn
                (setq val_spc (float (fix (+ (* interpolatedMaxProp 10) 0.5))))
                (setq val_spc (/ val_spc 10.0))
                (setq *glb_prop_spc* (rtos val_spc 2 1))
                (setq warningMsg (strcat warningMsg "Max capacity exceeded. Prop spacing reduced to " (rtos val_spc 2 1) "mm."))
              )
          )

          (setq z1 (GetInterpolatedBeamSpacing x1 val_spc))
          (setq z2 (GetInterpolatedBeamSpacing x2 val_spc))

          (if (= x1 x2)
              (setq finalZ z1)
              (setq finalZ (+ z1 (* (- sT x1) (/ (- z2 z1) (- x2 x1)))))
          )

          (setq currentBeamSpacing (* (fix (/ finalZ 25.0)) 25.0))

          (setq extensionMeters (- (- (/ val_fht 1000.0) (/ sT 1000.0)) 0.418))
          (setq roundedExtension (/ (float (fix (+ (* extensionMeters 10) 0.9999))) 10.0))

          (setq key (strcat *glb_prop_type* " at " *glb_prop_ori*))
          (setq vCap 11.00)

          (setq calc_success T)
          (setq actualPropLoad 0.0 propCapLimit 0.0 utilRate 0.0 h20Shear 0.0 h20Util 0.0)

          (while calc_success
            (setq L (/ currentBeamSpacing 1000.0))
            (setq P_m (/ val_spc 1000.0))
            (setq a (/ val_can 1000.0))

            (setq R_max 0.0)
            (if (> L 0)
                (progn
                  (setq a_over_L (/ a L))
                  (if (<= a_over_L 0.4534)
                      (setq R_max (* slabLoad (- (* 1.1 L) (* 0.6 (/ (* a a) L)))))
                      (setq R_max (* slabLoad (+ a (* 0.4 L) (* 0.6 (/ (* a a) L)))))
                  )
                )
            )

            (setq propLoad (* R_max P_m))
            (setq vMax (* 0.5 R_max P_m))

            (setq capacity (GetPropCapacity roundedExtension key))

            (if (or (null capacity) (> propLoad capacity) (> vMax vCap))
                (progn
                  (setq currentBeamSpacing (- currentBeamSpacing 25.0))
                  (if (<= currentBeamSpacing 0)
                      (progn
                        (setq warningMsg "Error: Cannot find safe primary beam spacing.")
                        (setq currentBeamSpacing 0.0)
                        (setq calc_success nil)
                      )
                  )
                )
                (progn
                  (setq actualPropLoad propLoad)
                  (setq propCapLimit capacity)
                  (if (> capacity 0) (setq utilRate (* (/ propLoad capacity) 100.0)) (setq utilRate 0.0))
                  (setq h20Shear vMax)
                  (setq h20Util (* (/ vMax vCap) 100.0))
                  (setq calc_success nil)
                )
            )
          )

          (if (/= warningMsg "")
              (alert warningMsg)
          )

          (setq *out_flex_beam_spc* (strcat "Safe Primary Beam Spacing: " (rtos currentBeamSpacing 2 0) " mm"))
          (setq *out_flex_act_ld* (strcat "Actual Prop Load: " (rtos actualPropLoad 2 2) " kN"))
          (setq *out_flex_cap_lim* (strcat "Prop Capacity limit used: " (rtos propCapLimit 2 2) " kN"))
          (setq *out_flex_ut_rt* (strcat "Prop Utilization Rate: " (rtos utilRate 2 1) " %"))
          (setq *out_flex_h20_shr* (strcat "H20 Shear: " (rtos h20Shear 2 2) " kN"))
          (setq *out_flex_h20_ut* (strcat "H20 Utilization: " (rtos h20Util 2 1) " %"))

          ;; SHOW OUTPUT DIALOG
          (setq outLoop T)
          (while outLoop
            (if (not (new_dialog "EngDashFlexOut" dclID))
                (progn (princ "\nError displaying Flex Output Dialog.") (setq outLoop nil) (setq flexLoop nil))
            )
            (set_tile "txt_beam_spc" *out_flex_beam_spc*)
            (set_tile "txt_act_ld" *out_flex_act_ld*)
            (set_tile "txt_cap_lim" *out_flex_cap_lim*)
            (set_tile "txt_ut_rt" *out_flex_ut_rt*)
            (set_tile "txt_h20_shr" *out_flex_h20_shr*)
            (set_tile "txt_h20_ut" *out_flex_h20_ut*)

            (action_tile "btn_back" "(done_dialog 0)")
            (action_tile "accept" "(done_dialog 1)")

            (setq out_ret (start_dialog))
            (if (= out_ret 1)
                (progn (setq outLoop nil) (setq flexLoop nil)) ;; Close everything
                (setq outLoop nil) ;; Back button, loop continues in input
            )
          )
        )
        (setq flexLoop nil) ;; Cancel from input
    )
  )
)

(defun RunPlateDialog ( dclID / plateLoop ret val_ld val_sp val_wid val_hdia val_ndia val_y calc_success b_eff load_N t_bend tau_allow t_punch max_t std_thks recommendedPlate py_idx)
  (setq plateLoop T)
  (while plateLoop
    (if (not (new_dialog "EngDashPlateIn" dclID))
        (progn (princ "\nError displaying Plate Input Dialog.") (setq plateLoop nil) (exit))
    )

    (start_list "pl_plt_yield") (mapcar 'add_list '("235" "275")) (end_list)
    (setq py_idx "0")
    (if (= *glb_plt_yield* "275.0") (setq py_idx "1"))

    (set_tile "eb_plt_load" *glb_plt_load*)
    (set_tile "eb_plt_span" *glb_plt_span*)
    (set_tile "eb_plt_wid" *glb_plt_wid*)
    (set_tile "eb_plt_hdia" *glb_plt_hdia*)
    (set_tile "eb_plt_ndia" *glb_plt_ndia*)
    (set_tile "pl_plt_yield" py_idx)

    (action_tile "eb_plt_load" "(setq *glb_plt_load* $value)")
    (action_tile "eb_plt_span" "(setq *glb_plt_span* $value)")
    (action_tile "eb_plt_wid" "(setq *glb_plt_wid* $value)")
    (action_tile "eb_plt_hdia" "(setq *glb_plt_hdia* $value)")
    (action_tile "eb_plt_ndia" "(setq *glb_plt_ndia* $value)")
    (action_tile "pl_plt_yield" "(setq py_idx (atoi $value)) (if (= py_idx 0) (setq *glb_plt_yield* \"235.0\") (setq *glb_plt_yield* \"275.0\"))")

    (action_tile "btn_calc" "(done_dialog 2)")
    (action_tile "cancel" "(done_dialog 0)")

    (setq ret (start_dialog))

    (if (= ret 2)
        (progn
          ;; PERFORM CALCULATION
          (setq val_ld (atof *glb_plt_load*))
          (setq val_sp (atof *glb_plt_span*))
          (setq val_wid (atof *glb_plt_wid*))
          (setq val_hdia (atof *glb_plt_hdia*))
          (setq val_ndia (atof *glb_plt_ndia*))
          (setq val_y (atof *glb_plt_yield*))

          (if (or (<= val_y 0) (<= val_ndia 0))
              (alert "Invalid Input.")
              (progn
                (setq b_eff (- val_wid val_hdia))
                (if (<= b_eff 0)
                    (alert "Error: Tie Hole Diameter must be smaller than Total Plate Width.")
                    (progn
                      (setq load_N (* val_ld 1000.0))
                      (setq t_bend (sqrt (/ (* 1.5 load_N val_sp) (* b_eff val_y))))
                      (setq tau_allow (* 0.4 val_y))
                      (setq t_punch (/ load_N (* pi val_ndia tau_allow)))
                      (setq max_t (max t_bend t_punch))

                      (setq std_thks '(4.0 5.0 6.0 8.0 10.0 12.0 15.0 16.0 20.0 25.0 30.0 40.0 50.0))
                      (setq recommendedPlate nil)
                      (foreach t_val std_thks
                        (if (and (null recommendedPlate) (>= t_val max_t))
                            (setq recommendedPlate t_val)
                        )
                      )

                      (setq *out_plt_bend_t* (strcat "Req Bending Thickness: " (rtos t_bend 2 2) " mm"))
                      (setq *out_plt_punch_t* (strcat "Req Punching Thickness: " (rtos t_punch 2 2) " mm"))
                      (if recommendedPlate
                          (setq *out_plt_rec_t* (strcat "Recommended Thickness: " (rtos recommendedPlate 2 1) " mm"))
                          (setq *out_plt_rec_t* "Recommended Thickness: Custom (>50mm)")
                      )

                      ;; SHOW OUTPUT DIALOG
                      (setq outLoop T)
                      (while outLoop
                        (if (not (new_dialog "EngDashPlateOut" dclID))
                            (progn (princ "\nError displaying Plate Output Dialog.") (setq outLoop nil) (setq plateLoop nil))
                        )
                        (set_tile "txt_bend_t" *out_plt_bend_t*)
                        (set_tile "txt_punch_t" *out_plt_punch_t*)
                        (set_tile "txt_rec_t" *out_plt_rec_t*)

                        (action_tile "btn_back" "(done_dialog 0)")
                        (action_tile "accept" "(done_dialog 1)")

                        (setq out_ret (start_dialog))
                        (if (= out_ret 1)
                            (progn (setq outLoop nil) (setq plateLoop nil)) ;; Close everything
                            (setq outLoop nil) ;; Back button
                        )
                      )
                    )
                )
              )
          )
        )
        (setq plateLoop nil) ;; Cancel from input
    )
  )
)
