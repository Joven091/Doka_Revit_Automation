;; AutoLISP Implementation of FlexCalculator and PlateCalculator

(defun c:EngDashboard ()
  (initget 1 "Flex Plate")
  (setq opt (getkword "\nSelect a Calculator [Flex/Plate]: "))
  (if (= opt "Flex")
      (FlexCalculator)
      (PlateCalculator)
  )
)

;; Flex Calculator
(defun FlexCalculator ( / slabThickness propSpacing floorHeight propType propOrientation secBeamCantilever
                        sT slabLoad x1 x2 maxP1 maxP2 interpolatedMaxProp
                        z1 z2 finalZ currentBeamSpacing extensionMeters roundedExtension
                        key vCap L P_m a a_over_L R_max propLoad vMax capacity
                        actualPropLoad propCapLimit utilRate h20Shear h20Util )

  (setq slabThickness (getreal "\nEnter Slab Thickness (mm) [default: 300]: "))
  (if (null slabThickness) (setq slabThickness 300.0))

  (setq floorHeight (getreal "\nEnter Floor Height (mm) [default: 3000]: "))
  (if (null floorHeight) (setq floorHeight 3000.0))

  (initget 1 "250 300 350 400 550")
  (setq propType (getkword "\nSelect Prop Type [250/300/350/400/550]: "))

  (initget 1 "bottom top")
  (setq propOrientation (getkword "\nSelect Prop Orientation [bottom/top]: "))

  (setq propSpacing (getreal "\nEnter Actual Prop Spacing (mm) [default: 1000]: "))
  (if (null propSpacing) (setq propSpacing 1000.0))

  (setq secBeamCantilever (getreal "\nEnter Secondary Beam Cantilever (mm) [default: 500]: "))
  (if (null secBeamCantilever) (setq secBeamCantilever 500.0))

  ;; Clamp Slab Thickness to 200 - 500
  (setq sT slabThickness)
  (if (< sT 200.0) (setq sT 200.0))
  (if (> sT 500.0) (setq sT 500.0))
  (if (/= sT slabThickness)
      (princ (strcat "\nWarning: Slab Thickness adjusted to " (rtos sT 2 1) "mm (Table Limits)."))
  )

  ;; Slab Load Helper
  (setq slabLoad (CalculateTotalLoad sT))

  ;; Get x1, x2 from TableData
  (setq x_vals '(200.0 220.0 240.0 260.0 280.0 300.0 350.0 400.0 450.0 500.0))
  (setq x1 (car x_vals))
  (foreach x x_vals
    (if (<= x sT) (setq x1 x))
  )
  (setq x2 (last x_vals))
  (foreach x (reverse x_vals)
    (if (>= x sT) (setq x2 x))
  )
  (if (= x1 0) (setq x1 x2))
  (if (= x2 0) (setq x2 x1))

  ;; Max Allowable Prop Spacing
  (setq maxP1 (GetMaxPropForThickness x1))
  (setq maxP2 (GetMaxPropForThickness x2))

  (if (= x1 x2)
      (setq interpolatedMaxProp maxP1)
      (setq interpolatedMaxProp (+ maxP1 (* (- sT x1) (/ (- maxP2 maxP1) (- x2 x1)))))
  )

  ;; Clamp Prop Spacing
  (if (> propSpacing interpolatedMaxProp)
      (progn
        (setq propSpacing (float (fix (+ (* interpolatedMaxProp 10) 0.5))) )
        (setq propSpacing (/ propSpacing 10.0))
        (princ (strcat "\nWarning: Max capacity exceeded. Prop spacing reduced to " (rtos propSpacing 2 1) "mm."))
      )
  )

  ;; Interpolate Beam Spacing
  (setq z1 (GetInterpolatedBeamSpacing x1 propSpacing))
  (setq z2 (GetInterpolatedBeamSpacing x2 propSpacing))

  (if (= x1 x2)
      (setq finalZ z1)
      (setq finalZ (+ z1 (* (- sT x1) (/ (- z2 z1) (- x2 x1)))))
  )

  (setq currentBeamSpacing (* (fix (/ finalZ 25.0)) 25.0))

  ;; Capacity Cross-Check
  (setq extensionMeters (- (- (/ floorHeight 1000.0) (/ sT 1000.0)) 0.418))
  (setq roundedExtension (/ (float (fix (+ (* extensionMeters 10) 0.9999))) 10.0))

  (setq key (strcat propType " at " propOrientation))
  (setq vCap 11.00)

  (setq loop T)
  (setq actualPropLoad 0.0 propCapLimit 0.0 utilRate 0.0 h20Shear 0.0 h20Util 0.0)

  (while loop
    (setq L (/ currentBeamSpacing 1000.0))
    (setq P_m (/ propSpacing 1000.0))
    (setq a (/ secBeamCantilever 1000.0))

    (setq R_max 0.0)
    (if (> L 0)
        (progn
          (setq a_over_L (/ a L))
          (if (<= a_over_L 0.4534)
              (setq R_max (* slabLoad (- (* 1.1 L) (* 0.6 (/ (* a a) L)))))
              (setq R_max (* slabLoad (+ a (* 0.4 L) (* 0.6 (/ (* a a) L)))))
          )
        )
    )

    (setq propLoad (* R_max P_m))
    (setq vMax (* 0.5 R_max P_m))

    (setq capacity (GetPropCapacity roundedExtension key))

    (if (or (null capacity) (> propLoad capacity) (> vMax vCap))
        (progn
          (setq currentBeamSpacing (- currentBeamSpacing 25.0))
          (if (<= currentBeamSpacing 0)
              (progn
                (princ "\nError: Cannot find safe primary beam spacing for given loads.")
                (setq currentBeamSpacing 0.0)
                (setq loop nil)
              )
          )
        )
        (progn
          (setq actualPropLoad propLoad)
          (setq propCapLimit capacity)
          (if (> capacity 0)
              (setq utilRate (* (/ propLoad capacity) 100.0))
              (setq utilRate 0.0)
          )
          (setq h20Shear vMax)
          (setq h20Util (* (/ vMax vCap) 100.0))
          (setq loop nil)
        )
    )
  )

  (princ "\n--- Flex Calculator Results ---")
  (princ (strcat "\nSafe Primary Beam Spacing: " (rtos currentBeamSpacing 2 0) " mm"))
  (princ (strcat "\nActual Prop Load: " (rtos actualPropLoad 2 2) " kN"))
  (princ (strcat "\nProp Capacity limit used: " (rtos propCapLimit 2 2) " kN"))
  (princ (strcat "\nProp Utilization Rate: " (rtos utilRate 2 1) " %"))
  (princ (strcat "\nH20 Shear: " (rtos h20Shear 2 2) " kN"))
  (princ (strcat "\nH20 Utilization: " (rtos h20Util 2 1) " %"))
  (princ "\n")
  (princ)
)

(defun CalculateTotalLoad (thickness)
  (setq h (/ thickness 1000.0))
  (setq concreteLoad (* h 25.0))
  (setq placingLoad (* 0.10 concreteLoad))
  (if (< placingLoad 0.75) (setq placingLoad 0.75))
  (if (> placingLoad 1.5) (setq placingLoad 1.5))
  (setq totalLoad (+ concreteLoad placingLoad 0.75 0.4))
  totalLoad
)

(defun GetMaxPropForThickness (thick)
  (setq data (cadr (assoc thick *FloorPropData*)))
  (setq maxP 0.0)
  (foreach pair data
    (if (> (car pair) maxP) (setq maxP (car pair)))
  )
  maxP
)

(defun GetInterpolatedBeamSpacing (thick targetProp / data sorted firstProp firstBeam lastProp lastBeam lower upper)
  (setq data (cadr (assoc thick *FloorPropData*)))
  ;; Data is already sorted by prop ascending in *FloorPropData*
  (setq firstProp (caar data))
  (setq firstBeam (cadar data))
  (setq lastProp (car (last data)))
  (setq lastBeam (cadr (last data)))

  (if (<= targetProp firstProp)
      firstBeam
      (if (>= targetProp lastProp)
          lastBeam
          (progn
            ;; Find lower and upper
            (setq lower nil upper nil)
            (foreach pair (reverse data)
              (if (and (null lower) (<= (car pair) targetProp))
                  (setq lower pair)
              )
            )
            (foreach pair data
              (if (and (null upper) (>= (car pair) targetProp))
                  (setq upper pair)
              )
            )
            (if (= (car lower) (car upper))
                (cadr lower)
                (+ (cadr lower) (* (- targetProp (car lower)) (/ (- (cadr upper) (cadr lower)) (- (car upper) (car lower)))))
            )
          )
      )
  )
)

(defun GetPropCapacity (ext key / extData cap)
  (setq extData (cdr (assoc ext *PropCapacities*)))
  (if extData
      (setq cap (cdr (assoc key extData)))
      (setq cap nil)
  )
  cap
)

;; Plate Calculator
(defun PlateCalculator ( / loadKN span plateWidth holeDia nutDia selectedYield b_eff load_N t_bend tau_allow t_punch max_t recommendedPlate std_thks )
  (setq loadKN (getreal "\nEnter Load (kN) [default: 90]: "))
  (if (null loadKN) (setq loadKN 90.0))

  (setq span (getreal "\nEnter Span (mm) [default: 100]: "))
  (if (null span) (setq span 100.0))

  (setq plateWidth (getreal "\nEnter Plate Width (mm) [default: 100]: "))
  (if (null plateWidth) (setq plateWidth 100.0))

  (setq holeDia (getreal "\nEnter Hole Diameter (mm) [default: 18]: "))
  (if (null holeDia) (setq holeDia 18.0))

  (setq nutDia (getreal "\nEnter Nut Diameter (mm) [default: 30]: "))
  (if (null nutDia) (setq nutDia 30.0))

  (initget 1 "235 275")
  (setq selectedYield (getreal "\nSelect Yield Strength (MPa) [235/275]: "))

  (if (or (<= selectedYield 0) (<= nutDia 0))
      (progn (princ "\nInvalid Input.") (exit))
  )

  (setq b_eff (- plateWidth holeDia))
  (if (<= b_eff 0)
      (progn (princ "\nError: Tie Hole Diameter must be smaller than Total Plate Width.") (exit))
  )

  (setq load_N (* loadKN 1000.0))
  (setq t_bend (sqrt (/ (* 1.5 load_N span) (* b_eff selectedYield))))

  (setq tau_allow (* 0.4 selectedYield))
  (setq t_punch (/ load_N (* pi nutDia tau_allow)))

  (setq max_t (max t_bend t_punch))

  (setq std_thks '(4.0 5.0 6.0 8.0 10.0 12.0 15.0 16.0 20.0 25.0 30.0 40.0 50.0))
  (setq recommendedPlate nil)
  (foreach t_val std_thks
    (if (and (null recommendedPlate) (>= t_val max_t))
        (setq recommendedPlate t_val)
    )
  )

  (princ "\n--- Plate Calculator Results ---")
  (princ (strcat "\nReq Bending Thickness: " (rtos t_bend 2 2) " mm"))
  (princ (strcat "\nReq Punching Thickness: " (rtos t_punch 2 2) " mm"))
  (if recommendedPlate
      (princ (strcat "\nRecommended Thickness: " (rtos recommendedPlate 2 1) " mm"))
      (princ "\nRecommended Thickness: Custom (>50mm)")
  )
  (princ "\n")
  (princ)
)
