(defun CalculateTotalLoad (thickness)
  (setq h (/ thickness 1000.0))
  (setq concreteLoad (* h 25.0))
  (setq placingLoad (* 0.10 concreteLoad))
  (if (< placingLoad 0.75) (setq placingLoad 0.75))
  (if (> placingLoad 1.5) (setq placingLoad 1.5))
  (setq totalLoad (+ concreteLoad placingLoad 0.75 0.4))
  totalLoad
)

(defun GetMaxPropForThickness (thick)
  (setq data (cadr (assoc thick *FloorPropData*)))
  (setq maxP 0.0)
  (foreach pair data
    (if (> (car pair) maxP) (setq maxP (car pair)))
  )
  maxP
)

(defun GetInterpolatedBeamSpacing (thick targetProp / data sorted firstProp firstBeam lastProp lastBeam lower upper)
  (setq data (cadr (assoc thick *FloorPropData*)))
  (setq firstProp (caar data))
  (setq firstBeam (cadar data))
  (setq lastProp (car (last data)))
  (setq lastBeam (cadr (last data)))

  (if (<= targetProp firstProp)
      firstBeam
      (if (>= targetProp lastProp)
          lastBeam
          (progn
            (setq lower nil upper nil)
            (foreach pair (reverse data)
              (if (and (null lower) (<= (car pair) targetProp))
                  (setq lower pair)
              )
            )
            (foreach pair data
              (if (and (null upper) (>= (car pair) targetProp))
                  (setq upper pair)
              )
            )
            (if (= (car lower) (car upper))
                (cadr lower)
                (+ (cadr lower) (* (- targetProp (car lower)) (/ (- (cadr upper) (cadr lower)) (- (car upper) (car lower)))))
            )
          )
      )
  )
)

(defun GetPropCapacity (ext key / extData cap)
  (setq extData (cdr (assoc ext *PropCapacities*)))
  (if extData
      (setq cap (cdr (assoc key extData)))
      (setq cap nil)
  )
  cap
)


